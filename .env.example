IMAP_HOST=imap.example.com
IMAP_PORT=993
IMAP_USER=your_account@example.com
IMAP_PASS=your_password_or_app_token
IMAP_MAILBOX=INBOX

# 用于匹配指定账户，例如 mailbox@company.com
TARGET_ACCOUNT_KEYWORD=mailbox@company.com

# 企业微信机器人 webhook 地址
WECOM_WEBHOOK=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# 轮询间隔（秒）
POLL_INTERVAL=30

# 状态文件（记录上次处理到的 UID）
STATE_FILE=.mail_forwarder_state.json
